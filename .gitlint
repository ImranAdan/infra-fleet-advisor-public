[general]
# Enforces the `type(scope): subject` form used throughout this repository.
contrib=contrib-title-conventional-commits
# Titles are linted as one-line messages. Commit bodies may contain generated
# package lists, immutable URLs and review context that should not be rewrapped.
ignore=body-is-missing,body-max-line-length

[title-max-length]
line-length=72
